<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <xacro:include filename="$(find navigation_bot)/description/inertial_macros.xacro"/>
<!--================================================================ COLOURS ==================================================================================================== -->

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

<!--================================================================ LINKS ====================================================================================================== -->

    <link name="left_pane"> <!-- base_link LINK -->
        <visual>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.4" y="0.03" z="0.3">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <link name="front_pane"> <!-- base_link LINK -->
        <visual>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
            <material name="white"/>
        </visual>

        <!-- Hole 1 (left front) -->
        <visual>
          <geometry>
            <cylinder radius="0.02" length="0.01"/>
          </geometry>
          <material name="black"/>
          <origin xyz="-0.05 -0.01 0" rpy="1.57 0 0"/>
        </visual>

        <!-- Hole 2 (right front) -->
        <visual>
          <geometry>
            <cylinder radius="0.02" length="0.01"/>
          </geometry>
          <material name="black"/>
          <origin xyz="0.05 -0.01 0" rpy="1.57 0 0"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.4" y="0.03" z="0.3">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <link name="back_pane"> <!-- base_link LINK -->
        <visual>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.4" y="0.03" z="0.3">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <link name="right_pane"> <!-- base_link LINK -->
        <visual>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.03 0.3"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.4" y="0.03" z="0.3">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <link name="base_link"> <!-- base_link LINK -->
    </link>

    <link name="front_wheel">
        <visual>
            <geometry>
                <sphere radius= "0.07"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius= "0.07"/>
            </geometry>
        </collision>
    </link>

    <link name="back_wheel">
        <visual>
            <geometry>
                <sphere radius= "0.07"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius= "0.07"/>
            </geometry>
        </collision>
    </link>

    <link name="back_left_wheel">
        <visual>
            <geometry>
                <cylinder radius= "0.07" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius= "0.07" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.07">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <link name="indicator_back_left_link">
        <visual>
            <geometry>
                <box size="0.1 0.01 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="back_right_wheel">
        <visual>
            <geometry>
                <cylinder radius= "0.07" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius= "0.07" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.07">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <link name="indicator_back_right_link">
        <visual>
            <geometry>
                <box size="0.1 0.01 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="camera_platform_link">
        <visual>
            <geometry>
                <box size="0.4 0.03 0.4"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.03 0.4"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.4" y="0.03" z="0.4">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

<!--================================================================ REFERENCES ================================================================================================= -->
    <gazebo reference="base_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="back_left_wheel">
        <mu1>1.7</mu1>
        <mu2>1.7</mu2>
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="indicator_back_left_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="front_wheel">
        <mu1>0.0007</mu1>
        <mu2>0.0007</mu2>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="back_wheel">
        <mu1>0.0007</mu1>
        <mu2>0.0007</mu2>
        <material>Gazebo/Black</material>
    </gazebo>


    <gazebo reference="back_right_wheel">
        <mu1>1.7</mu1>
        <mu2>1.7</mu2>
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="indicator_back_right_link">
        <material>Gazebo/White</material>
    </gazebo>

<!--================================================================ JOINTS ===================================================================================================== -->

    <joint name="left_reference" type="fixed">
        <parent link="base_link"/>
        <child link="left_pane"/>
        <origin xyz="0 -0.2 0.15"/>
    </joint>

    <joint name="right_reference" type="fixed">
        <parent link="base_link"/>
        <child link="right_pane"/>
        <origin xyz="0 0.2 0.15"/>
    </joint>

    <joint name="front_reference" type="fixed">
        <parent link="base_link"/>
        <child link="front_pane"/>
        <origin xyz="0.2 0 0.15" rpy="0 0 ${pi/2}"/>
    </joint>

    <joint name="back_reference" type="fixed">
        <parent link="base_link"/>
        <child link="back_pane"/>
        <origin xyz="-0.2 0 0.15" rpy="0 0 ${pi/2}"/>
    </joint>

    <joint name="Back_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_left_wheel"/>
        <origin xyz="0 -0.235 0" rpy="${pi/2} 0 0"/>
        <axis xyz ="0 0 -1"/>
    </joint>

    <joint name="front_wheel_joint" type="fixed">
        <parent link="front_pane"/>
        <child link="front_wheel"/>
        <origin xyz="0 -0.08 -0.15"/>
    </joint>

    <joint name="back_wheel_joint" type="fixed">
        <parent link="back_pane"/>
        <child link="back_wheel"/>
        <origin xyz="0 0.08 -0.15"/>
    </joint>

    <joint name="indicator_back_left_joint" type="fixed">
        <parent link ="back_left_wheel"/>
        <child link ="indicator_back_left_link"/>
        <origin xyz="0 0 0.02"/>
    </joint>

    <joint name="Back_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_right_wheel"/>
        <origin xyz="0 0.235 0" rpy="${pi/2} 0 0"/>
        <axis xyz ="0 0 -1"/>
    </joint>

    <joint name="indicator_back_right_joint" type="fixed">
        <parent link ="back_right_wheel"/>
        <child link ="indicator_back_right_link"/>
        <origin xyz="0 0 -0.02"/>
    </joint>

    <joint name="camera_platform_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_platform_link"/>
        <origin xyz="0 0 0.300" rpy="${pi/2} 0 0"/>
    </joint>

</robot>



