<?xml version="1.0"?>
<robot name="station">

  <!-- Base horizontal plane -->
  <link name="base_plane">
    <visual>
      <origin xyz="0 0 0.5" rpy="1.57 1.57 1.57"/>
      <geometry>
        <box size="1.0 0.5 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5" rpy="1.57 1.57 0"/>
      <geometry>
        <box size="1.0 0.5 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"/>
    </inertial>
  </link>

  <!-- Left 45° plane -->
  <link name="left_plane">
    <visual>
      <geometry>
        <box size="1.0 0.5 0.02"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 0.5 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"/>
    </inertial>
  </link>

  <!-- Right 45° plane -->
  <link name="right_plane">
    <visual>
      <geometry>
        <box size="1.0 0.5 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 0.5 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"/>
    </inertial>
  </link>

  <!-- Camera mount -->
  <link name="camera_mount">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.2"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- Fixed joints to hold everything together -->
  <joint name="left_joint" type="fixed">
    <parent link="base_plane"/>
    <child link="left_plane"/>
    <origin xyz="-0.176677 0.42677 0.5" rpy="1.57 1.57 -0.785398"/> <!-- Opposite tilt -->
  </joint>

  <joint name="right_joint" type="fixed">
    <parent link="base_plane"/>
    <child link="right_plane"/>
    <origin xyz="-0.176677 -0.42677 0.5" rpy="1.57 1.57 0.785398"/> <!-- Opposite tilt -->
  </joint>

  <joint name="cam_joint" type="fixed">
    <parent link="base_plane"/>
    <child link="camera_mount"/>
    <origin rpy="0 1.57 0" xyz="0 0 0.5"/>
  </joint>

</robot>

